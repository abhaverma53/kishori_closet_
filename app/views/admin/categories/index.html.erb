<% content_for :title, "Categories" %>
<div class="flex items-center justify-between">
  <h1 class="font-serif text-3xl">Categories</h1>
  <%= link_to "Add category", new_admin_category_path, class: "btn-primary" %>
</div>
<div class="mt-6 bg-white border border-stone-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Slug</th>
        <th class="px-4 py-3">Active</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3"><%= category.name %></td>
          <td class="px-4 py-3"><%= category.slug %></td>
          <td class="px-4 py-3"><%= category.active? ? "Yes" : "No" %></td>
          <td class="px-4 py-3 space-x-3">
            <%= link_to "Edit", edit_admin_category_path(category), class: "text-brand" %>
            <%= button_to "Delete", admin_category_path(category), method: :delete, class: "inline text-rose-700", data: { turbo_confirm: "Delete this category?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
