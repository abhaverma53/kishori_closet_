# Copy to .env and fill in real values. Never commit .env.

RAILS_ENV=production
PORT=3000

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Domain you will open in the browser, without https://
# Local Docker: localhost
# Live site: kishoricloset.com
APP_HOST=localhost

# false for http://localhost in Docker. true behind HTTPS / Nginx / Caddy.
FORCE_SSL=false

SHIPPING_FEE=0
WEB_CONCURRENCY=1

# Database password used by docker compose
POSTGRES_PASSWORD=change-me-to-a-strong-password

SMTP_USERNAME=kishoricloset@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAILER_FROM=Kishori Closet <kishoricloset@gmail.com>
