<% content_for :title, @customer.name %>
<h1 class="font-serif text-3xl">Customer details</h1>
<div class="mt-6 grid md:grid-cols-2 gap-6">
  <div class="bg-white border border-stone-100 p-6">
    <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Profile</h2>
    <p class="mt-3 font-medium"><%= @customer.name %></p>
    <p class="text-stone-600"><%= @customer.email %></p>
    <p class="text-stone-600"><%= @customer.phone.presence || "—" %></p>
  </div>
  <div class="bg-white border border-stone-100 p-6">
    <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Address</h2>
    <% if @addresses.any? %>
      <% @addresses.each do |address| %>
        <p class="mt-3 text-sm text-stone-600"><%= address.full_name %>, <%= address.full_address %></p>
      <% end %>
    <% else %>
      <p class="mt-3 text-stone-500">No saved address.</p>
    <% end %>
  </div>
</div>
<div class="mt-8 bg-white border border-stone-100">
  <h2 class="px-5 py-4 font-serif text-2xl border-b border-stone-100">Order history</h2>
  <div class="divide-y divide-stone-100">
    <% @orders.each do |order| %>
      <div class="px-5 py-4 flex items-center justify-between">
        <div>
          <p class="font-medium"><%= link_to order.order_number, admin_order_path(order), class: "text-brand" %></p>
          <p class="text-sm text-stone-500"><%= inr(order.total) %> · <%= order.status_label %></p>
        </div>
        <p class="text-sm text-stone-500"><%= order.created_at.strftime("%d %b %Y") %></p>
      </div>
    <% end %>
  </div>
</div>
