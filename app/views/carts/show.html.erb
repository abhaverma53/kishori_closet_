<% content_for :title, "Cart" %>
<section class="max-w-6xl mx-auto px-4 py-10">
  <h1 class="font-serif text-4xl md:text-5xl">Cart</h1>

  <% if @cart_items.any? %>
    <div class="mt-8 grid lg:grid-cols-[1fr_320px] gap-10">
      <div class="divide-y divide-stone-100">
        <% @cart_items.each do |item| %>
          <div class="py-6 grid grid-cols-[96px_1fr] sm:grid-cols-[120px_1fr_auto] gap-4 items-start">
            <div class="aspect-[3/4] bg-cream overflow-hidden">
              <%= product_image_tag item.product, classes: "w-full h-full object-cover" %>
            </div>
            <div>
              <h2 class="font-medium"><%= link_to item.product.name, product_path(item.product), class: "hover:text-brand" %></h2>
              <p class="text-sm text-stone-500 mt-1">Size: <%= item.product_variant.size %></p>
              <p class="text-brand mt-1"><%= inr(item.price) %></p>
              <div class="mt-3 flex items-center gap-3">
                <%= button_to "−", decrease_cart_path(cart_item_id: item.id), method: :patch, class: "w-8 h-8 border border-stone-300" %>
                <span class="min-w-6 text-center"><%= item.quantity %></span>
                <%= button_to "+", increase_cart_path(cart_item_id: item.id), method: :patch, class: "w-8 h-8 border border-stone-300" %>
              </div>
              <%= button_to "Remove", remove_item_cart_path(cart_item_id: item.id), method: :delete, class: "mt-3 text-xs uppercase tracking-[0.16em] text-stone-500 hover:text-brand" %>
            </div>
            <p class="hidden sm:block font-medium"><%= inr(item.line_total) %></p>
          </div>
        <% end %>
      </div>

      <aside class="border border-stone-100 p-6 h-fit bg-cream">
        <h2 class="text-xs uppercase tracking-[0.2em]">Summary</h2>
        <div class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between"><span>Subtotal</span><span><%= inr(@cart.subtotal) %></span></div>
          <div class="flex justify-between"><span>Shipping</span><span><%= inr(@cart.shipping_fee) %></span></div>
          <div class="flex justify-between font-medium text-base pt-3 border-t border-stone-200"><span>Total</span><span><%= inr(@cart.total) %></span></div>
        </div>
        <%= link_to "Checkout", checkout_path, class: "btn-primary w-full mt-6" %>
        <%= link_to "Continue shopping", shop_path, class: "btn-outline w-full mt-3" %>
        <%= button_to "Clear cart", cart_path, method: :delete, class: "w-full mt-3 text-xs uppercase tracking-[0.16em] text-stone-500", data: { turbo_confirm: "Clear all items from your cart?" } %>
      </aside>
    </div>
  <% else %>
    <p class="mt-8 text-stone-600">Your cart is empty.</p>
    <%= link_to "Continue shopping", shop_path, class: "btn-primary mt-6" %>
  <% end %>
</section>
