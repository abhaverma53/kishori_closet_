<% content_for :title, "Customers" %>
<h1 class="font-serif text-3xl">Customers</h1>
<%= form_with url: admin_customers_path, method: :get, local: true, class: "mt-6 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search name, email or phone", class: "field-input max-w-sm" %>
  <%= submit_tag "Search", class: "btn-dark cursor-pointer" %>
<% end %>
<div class="mt-6 bg-white border border-stone-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Phone</th>
        <th class="px-4 py-3">Orders</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3"><%= customer.name %></td>
          <td class="px-4 py-3"><%= customer.email %></td>
          <td class="px-4 py-3"><%= customer.phone %></td>
          <td class="px-4 py-3"><%= customer.orders.size %></td>
          <td class="px-4 py-3"><%= link_to "View", admin_customer_path(customer), class: "text-brand" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
