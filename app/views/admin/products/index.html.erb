<% content_for :title, "Products" %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <h1 class="font-serif text-3xl">Products</h1>
  <%= link_to "Add product", new_admin_product_path, class: "btn-primary" %>
</div>
<%= form_with url: admin_products_path, method: :get, local: true, class: "mt-6 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search products", class: "field-input max-w-sm" %>
  <%= submit_tag "Search", class: "btn-dark cursor-pointer" %>
<% end %>
<div class="mt-6 bg-white border border-stone-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
      <tr>
        <th class="px-4 py-3">Product</th>
        <th class="px-4 py-3">SKU</th>
        <th class="px-4 py-3">Price</th>
        <th class="px-4 py-3">Stock</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3">
            <p class="font-medium"><%= product.name %></p>
            <p class="text-stone-500"><%= product.category.name %></p>
          </td>
          <td class="px-4 py-3"><%= product.sku %></td>
          <td class="px-4 py-3"><%= inr(product.price) %></td>
          <td class="px-4 py-3"><%= product.total_stock %></td>
          <td class="px-4 py-3"><%= product.active? ? "Active" : "Inactive" %></td>
          <td class="px-4 py-3 space-x-2 whitespace-nowrap">
            <%= link_to "Edit", edit_admin_product_path(product), class: "text-brand" %>
            <%= button_to (product.active? ? "Deactivate" : "Activate"), toggle_active_admin_product_path(product), method: :patch, class: "inline text-stone-500" %>
            <%= button_to "Delete", admin_product_path(product), method: :delete, class: "inline text-rose-700", data: { turbo_confirm: "Delete this product?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
