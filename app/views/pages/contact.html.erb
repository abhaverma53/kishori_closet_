<% content_for :title, "Contact" %>
<section class="max-w-3xl mx-auto px-4 py-16">
  <h1 class="font-serif text-5xl">Contact</h1>
  <p class="mt-4 text-stone-600">We’d love to help with orders, sizing and styling.</p>
  <div class="mt-10 grid gap-6">
    <div class="border border-stone-100 p-6">
      <p class="text-xs tracking-[0.2em] uppercase text-brand">Phone</p>
      <p class="mt-2 text-lg"><%= KishoriCloset::CONTACT_PHONE %></p>
    </div>
    <div class="border border-stone-100 p-6">
      <p class="text-xs tracking-[0.2em] uppercase text-brand">Email</p>
      <p class="mt-2 text-lg"><%= mail_to KishoriCloset::CONTACT_EMAIL, KishoriCloset::CONTACT_EMAIL, class: "text-navy hover:text-brand" %></p>
    </div>
    <div class="border border-stone-100 p-6">
      <p class="text-xs tracking-[0.2em] uppercase text-brand">WhatsApp</p>
      <p class="mt-2"><%= link_to "Chat with us", whatsapp_url, target: "_blank", rel: "noopener", class: "btn-primary mt-2" %></p>
    </div>
  </div>
</section>
