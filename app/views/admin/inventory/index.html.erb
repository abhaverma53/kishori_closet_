<% content_for :title, "Inventory" %>
<h1 class="font-serif text-3xl">Inventory</h1>
<%= form_with url: admin_inventory_path, method: :get, local: true, class: "mt-6 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search product", class: "field-input max-w-sm" %>
  <%= submit_tag "Search", class: "btn-dark cursor-pointer" %>
<% end %>
<div class="mt-6 bg-white border border-stone-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
      <tr>
        <th class="px-4 py-3">Product</th>
        <th class="px-4 py-3">Size</th>
        <th class="px-4 py-3">SKU</th>
        <th class="px-4 py-3">Stock</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @variants.each do |variant| %>
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3"><%= variant.product.name %></td>
          <td class="px-4 py-3"><%= variant.size %></td>
          <td class="px-4 py-3"><%= variant.sku %></td>
          <td class="px-4 py-3" colspan="3">
            <%= form_with url: admin_update_inventory_path(variant), method: :patch, local: true, class: "flex items-center gap-3" do %>
              <%= number_field_tag :stock_quantity, variant.stock_quantity, min: 0, class: "field-input !py-2 w-24" %>
              <%= stock_badge(variant.stock_status) %>
              <%= submit_tag "Update", class: "btn-outline !py-2 cursor-pointer" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
