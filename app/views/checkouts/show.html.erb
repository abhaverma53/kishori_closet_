<% content_for :title, "Checkout" %>
<section class="max-w-6xl mx-auto px-4 py-10">
  <h1 class="font-serif text-4xl md:text-5xl">Checkout</h1>

  <%= form_with url: checkout_path, method: :post, local: true, class: "mt-8 grid lg:grid-cols-[1fr_360px] gap-10" do %>
    <div class="space-y-8">
      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Customer information</h2>
        <div class="mt-4 grid sm:grid-cols-2 gap-4">
          <div>
            <label class="text-xs uppercase tracking-[0.14em]">Name</label>
            <%= text_field_tag "checkout[customer_name]", @address&.full_name || current_user.name, required: true, class: "field-input mt-2" %>
          </div>
          <div>
            <label class="text-xs uppercase tracking-[0.14em]">Phone</label>
            <%= text_field_tag "checkout[customer_phone]", @address&.phone || current_user.phone, required: true, class: "field-input mt-2" %>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Delivery address</h2>
        <div class="mt-4 space-y-4">
          <%= text_field_tag "checkout[address_line_1]", @address&.address_line_1, required: true, placeholder: "Address line 1", class: "field-input" %>
          <%= text_field_tag "checkout[address_line_2]", @address&.address_line_2, placeholder: "Address line 2 (optional)", class: "field-input" %>
          <div class="grid sm:grid-cols-3 gap-4">
            <%= text_field_tag "checkout[city]", @address&.city, required: true, placeholder: "City", class: "field-input" %>
            <%= text_field_tag "checkout[state]", @address&.state, required: true, placeholder: "State", class: "field-input" %>
            <%= text_field_tag "checkout[pincode]", @address&.pincode, required: true, placeholder: "Pincode", class: "field-input" %>
          </div>
          <label class="flex items-center gap-2 text-sm text-stone-600">
            <%= check_box_tag "checkout[save_address]", "1", @address.blank? %>
            Save this address to my account
          </label>
        </div>
      </div>

      <div class="border border-stone-100 p-6">
        <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Payment</h2>
        <p class="mt-3 font-medium">UPI</p>
        <p class="text-sm text-stone-500 mt-1">After you place the order, a QR code will appear. Pay <%= inr(current_cart.total) %> and then confirm payment.</p>
      </div>
    </div>

    <aside class="border border-stone-100 p-6 h-fit bg-cream">
      <h2 class="text-xs uppercase tracking-[0.2em]">Order summary</h2>
      <div class="mt-4 space-y-3 text-sm">
        <% @cart_items.each do |item| %>
          <div class="flex justify-between gap-3">
            <div>
              <p><%= item.product.name %></p>
              <p class="text-stone-500">Size: <%= item.product_variant.size %> · Qty <%= item.quantity %></p>
            </div>
            <p><%= inr(item.line_total) %></p>
          </div>
        <% end %>
      </div>
      <div class="mt-4 pt-4 border-t border-stone-200 space-y-2 text-sm">
        <div class="flex justify-between"><span>Subtotal</span><span><%= inr(current_cart.subtotal) %></span></div>
        <div class="flex justify-between"><span>Shipping</span><span><%= inr(current_cart.shipping_fee) %></span></div>
        <div class="flex justify-between font-medium text-base"><span>Total</span><span><%= inr(current_cart.total) %></span></div>
      </div>
      <%= submit_tag "Continue to payment", class: "btn-primary w-full mt-6 cursor-pointer" %>
    </aside>
  <% end %>
</section>
