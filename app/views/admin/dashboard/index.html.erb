<% content_for :title, "Dashboard" %>
<h1 class="font-serif text-3xl">Admin Dashboard</h1>
<div class="mt-8 grid grid-cols-2 lg:grid-cols-5 gap-4">
  <% [
    ["Total Products", @product_count],
    ["Total Customers", @customer_count],
    ["Total Orders", @order_count],
    ["Pending Orders", @pending_orders],
    ["Delivered Orders", @delivered_orders]
  ].each do |label, value| %>
    <div class="bg-white border border-stone-100 p-5">
      <p class="text-xs uppercase tracking-[0.16em] text-stone-500"><%= label %></p>
      <p class="mt-2 font-serif text-4xl text-brand"><%= value %></p>
    </div>
  <% end %>
</div>

<div class="mt-10 bg-white border border-stone-100">
  <div class="px-5 py-4 border-b border-stone-100 flex items-center justify-between">
    <h2 class="font-serif text-2xl">Recent Orders</h2>
    <%= link_to "View all", admin_orders_path, class: "text-xs uppercase tracking-[0.16em] text-brand" %>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
        <tr>
          <th class="px-5 py-3">Order</th>
          <th class="px-5 py-3">Customer</th>
          <th class="px-5 py-3">Total</th>
          <th class="px-5 py-3">Payment</th>
          <th class="px-5 py-3">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_orders.each do |order| %>
          <tr class="border-t border-stone-100">
            <td class="px-5 py-3"><%= link_to order.order_number, admin_order_path(order), class: "text-brand" %></td>
            <td class="px-5 py-3"><%= order.customer_name %></td>
            <td class="px-5 py-3"><%= inr(order.total) %></td>
            <td class="px-5 py-3">COD</td>
            <td class="px-5 py-3"><%= order_status_badge(order.order_status) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
