<% content_for :title, "Orders" %>
<h1 class="font-serif text-3xl">Orders</h1>
<%= form_with url: admin_orders_path, method: :get, local: true, class: "mt-6 flex flex-wrap gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search order number, name or phone", class: "field-input max-w-sm" %>
  <%= select_tag :status, options_for_select([["All statuses", ""]] + Order::STATUSES.map { |s| [s.titleize, s] }, params[:status]), class: "field-input max-w-xs" %>
  <%= submit_tag "Search", class: "btn-dark cursor-pointer" %>
<% end %>
<div class="mt-6 bg-white border border-stone-100 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-xs uppercase tracking-[0.14em] text-stone-500 bg-cream">
      <tr>
        <th class="px-4 py-3">Order Number</th>
        <th class="px-4 py-3">Customer</th>
        <th class="px-4 py-3">Phone</th>
        <th class="px-4 py-3">Total</th>
        <th class="px-4 py-3">Payment</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3">Date</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr class="border-t border-stone-100">
          <td class="px-4 py-3"><%= link_to order.order_number, admin_order_path(order), class: "text-brand" %></td>
          <td class="px-4 py-3"><%= order.customer_name %></td>
          <td class="px-4 py-3"><%= order.customer_phone %></td>
          <td class="px-4 py-3"><%= inr(order.total) %></td>
          <td class="px-4 py-3"><%= order.payment_label %></td>
          <td class="px-4 py-3"><%= order_status_badge(order.order_status) %></td>
          <td class="px-4 py-3"><%= order.created_at.strftime("%d %b %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
