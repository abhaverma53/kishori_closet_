<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Admin" : "Admin · Kishori Closet" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-cream text-navy antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden md:flex w-64 flex-col bg-navy text-white">
        <div class="p-6 border-b border-white/10">
          <%= link_to admin_root_path, class: "block" do %>
            <%= image_tag "logo.png", alt: "Kishori Closet", class: "h-16 w-16 rounded-full object-cover bg-white mx-auto" %>
            <p class="mt-3 text-center text-xs tracking-[0.2em] uppercase text-white/80">Admin</p>
          <% end %>
        </div>
        <nav class="flex-1 p-4 space-y-1 text-sm">
          <%= link_to "Dashboard", admin_dashboard_path, class: "block px-3 py-2 rounded hover:bg-white/10 #{current_page?(admin_dashboard_path) || current_page?(admin_root_path) ? 'bg-white/10' : ''}" %>
          <%= link_to "Products", admin_products_path, class: "block px-3 py-2 rounded hover:bg-white/10" %>
          <%= link_to "Categories", admin_categories_path, class: "block px-3 py-2 rounded hover:bg-white/10" %>
          <%= link_to "Inventory", admin_inventory_path, class: "block px-3 py-2 rounded hover:bg-white/10" %>
          <%= link_to "Orders", admin_orders_path, class: "block px-3 py-2 rounded hover:bg-white/10" %>
          <%= link_to "Customers", admin_customers_path, class: "block px-3 py-2 rounded hover:bg-white/10" %>
        </nav>
        <div class="p-4 border-t border-white/10 text-sm space-y-2">
          <%= link_to "View store", root_path, class: "block px-3 py-2 hover:text-gold" %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block px-3 py-2 text-left w-full hover:text-gold" %>
        </div>
      </aside>
      <div class="flex-1 min-w-0">
        <header class="bg-white border-b border-stone-200 px-4 md:px-8 py-4 flex items-center justify-between">
          <div class="md:hidden font-serif text-xl text-brand">Kishori Admin</div>
          <p class="text-sm text-stone-500">Signed in as <%= current_user.name %></p>
        </header>
        <div class="md:hidden bg-navy text-white px-4 py-3 flex gap-4 overflow-x-auto text-xs uppercase tracking-wider">
          <%= link_to "Dashboard", admin_dashboard_path %>
          <%= link_to "Products", admin_products_path %>
          <%= link_to "Orders", admin_orders_path %>
          <%= link_to "Inventory", admin_inventory_path %>
          <%= link_to "Customers", admin_customers_path %>
        </div>
        <%= render "shared/flash" %>
        <main class="p-4 md:p-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
