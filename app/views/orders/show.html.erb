<% content_for :title, @order.order_number %>
<section class="max-w-4xl mx-auto px-4 py-10">
  <p class="text-xs uppercase tracking-[0.18em] text-stone-400"><%= link_to "My Orders", orders_path %> / <%= @order.order_number %></p>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-serif text-4xl"><%= @order.order_number %></h1>
    <%= order_status_badge(@order.order_status) %>
  </div>
  <p class="text-sm text-stone-500 mt-2"><%= @order.created_at.strftime("%d %b %Y, %I:%M %p") %></p>

  <div class="mt-8 grid md:grid-cols-2 gap-6">
    <div class="border border-stone-100 p-6">
      <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Delivery address</h2>
      <p class="mt-3"><%= @order.customer_name %><br><%= @order.customer_phone %></p>
      <p class="mt-2 text-stone-600"><%= @order.delivery_address %></p>
    </div>
    <div class="border border-stone-100 p-6">
      <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Payment</h2>
      <p class="mt-3"><%= @order.payment_label %></p>
      <p class="text-stone-600 mt-1">Status: <%= @order.payment_status_label %></p>
      <% if @order.payment_reference.present? %>
        <p class="text-sm text-stone-500 mt-1">UTR: <%= @order.payment_reference %></p>
      <% end %>
      <% if @order.unpaid? %>
        <%= link_to @order.payment_claimed? ? "View payment status" : "Pay with UPI", pay_order_path(@order), class: "btn-primary mt-4" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-xs uppercase tracking-[0.2em] text-brand">Products</h2>
    <div class="mt-4 divide-y divide-stone-100">
      <% @order.order_items.each do |item| %>
        <div class="py-4 flex justify-between gap-4">
          <div>
            <p class="font-medium"><%= item.product_name %></p>
            <p class="text-sm text-stone-500">Size: <%= item.size %> · Qty <%= item.quantity %> · <%= item.sku %></p>
          </div>
          <p><%= inr(item.total) %></p>
        </div>
      <% end %>
    </div>
    <div class="mt-4 pt-4 border-t border-stone-200 flex justify-between font-medium">
      <span>Total</span>
      <span><%= inr(@order.total) %></span>
    </div>
  </div>
</section>
