<%= form_with model: address, local: true, class: "mt-8 space-y-4" do |f| %>
  <% if address.errors.any? %>
    <div class="text-sm text-rose-700"><%= address.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= f.text_field :full_name, placeholder: "Full name", required: true, class: "field-input" %>
  <%= f.text_field :phone, placeholder: "Phone", required: true, class: "field-input" %>
  <%= f.text_field :address_line_1, placeholder: "Address line 1", required: true, class: "field-input" %>
  <%= f.text_field :address_line_2, placeholder: "Address line 2", class: "field-input" %>
  <%= f.text_field :city, placeholder: "City", required: true, class: "field-input" %>
  <%= f.text_field :state, placeholder: "State", required: true, class: "field-input" %>
  <%= f.text_field :pincode, placeholder: "Pincode", required: true, class: "field-input" %>
  <%= f.submit "Save address", class: "btn-primary cursor-pointer" %>
<% end %>
