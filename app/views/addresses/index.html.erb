<% content_for :title, "Addresses" %>
<section class="max-w-4xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between gap-4">
    <h1 class="font-serif text-4xl">Delivery addresses</h1>
    <%= link_to "Add address", new_address_path, class: "btn-primary" %>
  </div>
  <% if @addresses.any? %>
    <div class="mt-8 grid md:grid-cols-2 gap-4">
      <% @addresses.each do |address| %>
        <div class="border border-stone-100 p-6">
          <p class="font-medium"><%= address.full_name %></p>
          <p class="text-sm text-stone-600 mt-1"><%= address.phone %></p>
          <p class="text-sm text-stone-600 mt-2"><%= address.full_address %></p>
          <div class="mt-4 flex gap-3 text-xs uppercase tracking-[0.16em]">
            <%= link_to "Edit", edit_address_path(address), class: "text-brand" %>
            <%= button_to "Remove", address_path(address), method: :delete, class: "text-stone-500", data: { turbo_confirm: "Remove this address?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-8 text-stone-500">No addresses saved yet.</p>
  <% end %>
</section>
