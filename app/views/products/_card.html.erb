<%= link_to product_path(product), class: "group block" do %>
  <div class="aspect-[3/4] bg-cream overflow-hidden mb-3">
    <%= product_image_tag product, classes: "w-full h-full object-cover group-hover:scale-105 transition duration-500" %>
  </div>
  <p class="text-xs uppercase tracking-[0.16em] text-stone-500"><%= product.category.name %></p>
  <h3 class="mt-1 text-sm md:text-base font-medium"><%= product.name %></h3>
  <p class="mt-1 text-brand font-medium"><%= inr(product.price) %></p>
<% end %>
