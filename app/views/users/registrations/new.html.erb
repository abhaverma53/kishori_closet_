<% content_for :title, "Sign up" %>
<section class="max-w-md mx-auto px-4 py-16">
  <h1 class="font-serif text-4xl text-center">Create account</h1>
  <p class="text-center text-stone-500 mt-2">Join Kishori Closet to place orders with Cash on Delivery.</p>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-4" }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>
    <%= f.text_field :name, autofocus: true, placeholder: "Full name", required: true, class: "field-input" %>
    <%= f.email_field :email, autocomplete: "email", placeholder: "Email", required: true, class: "field-input" %>
    <%= f.telephone_field :phone, placeholder: "Phone", class: "field-input" %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password (#{@minimum_password_length} characters minimum)", class: "field-input" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: "field-input" %>
    <%= f.submit "Sign up", class: "btn-primary w-full cursor-pointer" %>
  <% end %>
  <p class="mt-6 text-center text-sm text-stone-600">
    Already have an account? <%= link_to "Sign in", new_user_session_path, class: "text-brand" %>
  </p>
</section>
