<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Kishori Closet" : "Kishori Closet · Style That Speaks You" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Kishori Closet — contemporary Indian fashion. Western wear, ethnic wear, co-ord sets and accessories.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-navy antialiased">
    <%= render "shared/announcement" %>
    <%= render "shared/header" %>
    <%= render "shared/flash" %>
    <main class="flex-1">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
