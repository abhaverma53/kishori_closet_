<% content_for :title, "Pay for #{@order.order_number}" %>
<section class="max-w-xl mx-auto px-4 py-12 text-center">
  <p class="text-xs tracking-[0.25em] uppercase text-gold">Kishori Closet</p>
  <% if @order.payment_claimed? %>
    <h1 class="font-serif text-4xl mt-3">Payment submitted</h1>
    <p class="mt-3 text-stone-600">We have your UPI transaction ID. Kishori Closet will confirm the order after the payment of <strong><%= inr(@order.total) %></strong> is verified.</p>
  <% else %>
    <h1 class="font-serif text-4xl mt-3">Pay to confirm your order</h1>
    <p class="mt-3 text-stone-600">Scan the QR code with any UPI app. Pay <strong><%= inr(@order.total) %></strong>, then enter the transaction ID from your payment app.</p>
  <% end %>

  <div class="mt-8 bg-white border border-stone-100 rounded-2xl p-6">
    <p class="text-sm text-stone-500">Amount to pay</p>
    <p class="font-serif text-5xl text-brand mt-1"><%= inr(@order.total) %></p>
    <p class="mt-2 text-sm text-stone-500"><%= @order.order_number %></p>

    <div class="mt-6 mx-auto max-w-xs bg-white p-4 rounded-2xl">
      <%= image_tag "upi_qr.png", alt: "UPI QR code for #{KishoriCloset::UPI_ID}", class: "w-full h-auto" %>
    </div>

    <p class="mt-4 text-sm font-medium">UPI ID: <%= KishoriCloset::UPI_ID %></p>
    <p class="mt-1 text-xs text-stone-500">Scan to pay with any UPI app</p>

    <%= link_to "Open UPI app", @order.upi_pay_url, class: "btn-outline w-full mt-6" %>
  </div>

  <% if @order.payment_claimed? %>
    <div class="mt-6 bg-amber-50 border border-amber-100 rounded-2xl p-5 text-left">
      <p class="text-sm font-medium text-amber-900">Awaiting verification</p>
      <p class="mt-2 text-sm text-amber-800">UPI transaction ID: <strong><%= @order.payment_reference %></strong></p>
      <p class="mt-2 text-xs text-amber-700">Clicking “I have paid” does not confirm the order. Confirmation happens only after Kishori Closet checks that this payment arrived.</p>
    </div>
  <% end %>

  <%= form_with url: confirm_payment_order_path(@order), method: :post, local: true, class: "mt-6 text-left" do %>
    <label for="payment_reference" class="text-sm font-medium">UPI transaction ID / UTR</label>
    <p class="mt-1 text-xs text-stone-500">Open GPay, PhonePe or your bank app after paying, copy the 12-digit UPI Ref / UTR, and paste it here.</p>
    <%= text_field_tag :payment_reference, @order.payment_reference, id: "payment_reference", required: true, minlength: 8, maxlength: 30, autocomplete: "off", placeholder: "e.g. 123456789012", class: "field-input mt-2 w-full uppercase tracking-wide" %>
    <%= submit_tag @order.payment_claimed? ? "Update transaction ID" : "I have paid #{inr(@order.total)}", class: "btn-primary w-full mt-4 cursor-pointer" %>
  <% end %>
  <p class="mt-4 text-xs text-stone-500">Your order is confirmed only after Kishori Closet verifies the payment. A confirmation email is sent then, not when you tap this button.</p>
</section>
