<% content_for :title, @order.order_number %>
<h1 class="font-serif text-3xl">Order #<%= @order.order_number %></h1>
<div class="mt-6 grid md:grid-cols-2 gap-6">
  <div class="bg-white border border-stone-100 p-6">
    <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Customer</h2>
    <p class="mt-3 font-medium"><%= @order.customer_name %></p>
    <p><%= @order.customer_phone %></p>
    <p class="text-stone-500 text-sm"><%= @order.user.email %></p>
  </div>
  <div class="bg-white border border-stone-100 p-6">
    <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Delivery address</h2>
    <p class="mt-3 text-stone-600"><%= @order.delivery_address %></p>
  </div>
</div>
<div class="mt-6 bg-white border border-stone-100 p-6">
  <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Products</h2>
  <div class="mt-4 divide-y divide-stone-100">
    <% @order.order_items.each do |item| %>
      <div class="py-3 flex justify-between">
        <div>
          <p class="font-medium"><%= item.product_name %></p>
          <p class="text-sm text-stone-500">Size: <%= item.size %> · Qty: <%= item.quantity %> · <%= item.sku %></p>
        </div>
        <p><%= inr(item.total) %></p>
      </div>
    <% end %>
  </div>
  <div class="mt-4 pt-4 border-t flex justify-between font-medium">
    <span>Total</span>
    <span><%= inr(@order.total) %></span>
  </div>
  <p class="mt-4 text-sm text-stone-500">Payment: Cash on Delivery · <%= @order.payment_status.titleize %></p>
</div>
<div class="mt-6 bg-white border border-stone-100 p-6 max-w-md">
  <h2 class="text-xs uppercase tracking-[0.16em] text-brand">Order status</h2>
  <%= form_with model: [:admin, @order], local: true, class: "mt-4 space-y-3" do |f| %>
    <%= f.select :order_status, Order::STATUSES.map { |s| [s.titleize, s] }, {}, class: "field-input" %>
    <%= f.submit "Update status", class: "btn-primary cursor-pointer" %>
  <% end %>
</div>
