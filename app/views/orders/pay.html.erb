<% content_for :title, "Pay for #{@order.order_number}" %>
<section class="max-w-xl mx-auto px-4 py-12 text-center">
  <p class="text-xs tracking-[0.25em] uppercase text-gold">Kishori Closet</p>
  <h1 class="font-serif text-4xl mt-3">Pay to confirm your order</h1>
  <p class="mt-3 text-stone-600">Scan the QR code with any UPI app. Pay <strong><%= inr(@order.total) %></strong> and then tap the button below.</p>

  <div class="mt-8 bg-white border border-stone-100 rounded-2xl p-6">
    <p class="text-sm text-stone-500">Amount to pay</p>
    <p class="font-serif text-5xl text-brand mt-1"><%= inr(@order.total) %></p>
    <p class="mt-2 text-sm text-stone-500"><%= @order.order_number %></p>

    <div class="mt-6 mx-auto max-w-xs bg-white p-4 rounded-2xl">
      <%= image_tag "upi_qr.png", alt: "UPI QR code for #{KishoriCloset::UPI_ID}", class: "w-full h-auto" %>
    </div>

    <p class="mt-4 text-sm font-medium">UPI ID: <%= KishoriCloset::UPI_ID %></p>
    <p class="mt-1 text-xs text-stone-500">Scan to pay with any UPI app</p>

    <%= link_to "Open UPI app", @order.upi_pay_url, class: "btn-outline w-full mt-6" %>
  </div>

  <%= button_to "I have paid #{inr(@order.total)}", confirm_payment_order_path(@order), method: :post, class: "btn-primary w-full mt-6", data: { turbo_confirm: "Confirm only after you have paid #{inr(@order.total)} on UPI." } %>
  <p class="mt-4 text-xs text-stone-500">Your order is confirmed only after payment. A confirmation email with the amount will then be sent to you and to Kishori Closet.</p>
</section>
