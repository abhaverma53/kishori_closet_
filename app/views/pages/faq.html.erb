<% content_for :title, "FAQ" %>
<section class="max-w-3xl mx-auto px-4 py-16">
  <h1 class="font-serif text-5xl">FAQ</h1>
  <div class="mt-8 space-y-6">
    <div>
      <h2 class="font-medium">Do you offer Cash on Delivery?</h2>
      <p class="text-stone-600 mt-1">Yes. COD is the only payment method right now.</p>
    </div>
    <div>
      <h2 class="font-medium">How do I choose a size?</h2>
      <p class="text-stone-600 mt-1">Each product lists available sizes. Out of stock sizes cannot be added to cart. If you need help, message us on WhatsApp.</p>
    </div>
    <div>
      <h2 class="font-medium">Can I change my order?</h2>
      <p class="text-stone-600 mt-1">Write to us as soon as possible with your order number. Once packed, changes may not be possible.</p>
    </div>
  </div>
</section>
